NODE_ENV=development
PORT=3001

# Postgres + PostGIS — khớp với infra/docker-compose.yml
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=rong
DB_PASSWORD=rong
DB_DATABASE=rong

# Redis — Socket.IO adapter và hàng đợi worker
REDIS_HOST=localhost
REDIS_PORT=6379

# Google Maps Platform — gọi theo thời gian thực, chỉ lưu place_id (PRD mục 7.4)
GOOGLE_MAPS_API_KEY=

# Gemini API, gói trả phí (PRD mục 7.4, nguyên tắc 5)
GEMINI_API_KEY=

# Xác thực — sinh khóa bằng: openssl rand -base64 48 (tối thiểu 32 ký tự)
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
GUEST_RETENTION_DAYS=30

# Xác minh email sau khi đăng ký. Link gửi đi là EMAIL_VERIFICATION_URL?token=...
# Trang đó (web/app) gọi POST /api/auth/verify-email với token nhận được.
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
EMAIL_VERIFICATION_TTL_HOURS=24

# Gửi email qua SMTP. Để trống SMTP_HOST thì email chỉ được ghi ra log (tiện khi dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Rong <no-reply@rong.local>
