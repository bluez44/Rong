NODE_ENV=development
PORT=3001

# Postgres + PostGIS — khớp với infra/docker-compose.yml
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=rong
DB_PASSWORD=rong
DB_DATABASE=rong

# Redis — Socket.IO adapter và hàng đợi worker
REDIS_HOST=localhost
REDIS_PORT=6379

# Google Maps Platform — gọi theo thời gian thực, chỉ lưu place_id (PRD mục 7.4)
GOOGLE_MAPS_API_KEY=

# Gemini API, gói trả phí (PRD mục 7.4, nguyên tắc 5)
GEMINI_API_KEY=
