NODE_ENV=development
PORT=3001

# Postgres + PostGIS — khớp với infra/docker-compose.yml
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=rong
DB_PASSWORD=rong
DB_DATABASE=rong

# Redis — Socket.IO adapter và hàng đợi worker
REDIS_HOST=localhost
REDIS_PORT=6379

# Google Maps Platform — gọi theo thời gian thực, chỉ lưu place_id (PRD mục 7.4)
GOOGLE_MAPS_API_KEY=

# Gemini API, gói trả phí (PRD mục 7.4, nguyên tắc 5)
GEMINI_API_KEY=

# Xác thực — sinh khóa bằng: openssl rand -base64 48 (tối thiểu 32 ký tự)
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
GUEST_RETENTION_DAYS=30

# Xác minh email sau khi đăng ký: gửi mã 6 chữ số, người dùng nhập mã trong app.
EMAIL_VERIFICATION_TTL_MINUTES=15

# Gửi email qua SMTP. Để trống SMTP_HOST thì email chỉ được ghi ra log (tiện khi dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Rong <no-reply@rong.local>

# Dữ liệu mở cho tìm kiếm điểm đến (S2). Instance công cộng có giới hạn: Nominatim
# 1 request/giây, không dùng cho autocomplete. Production nên tự host hoặc dùng
# nhà cung cấp trả phí, rồi trỏ các URL dưới đây sang đó.
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
WIKIDATA_URL=https://www.wikidata.org/w/api.php
# Bắt buộc theo chính sách sử dụng của OSM: email liên hệ gửi kèm User-Agent.
OPEN_DATA_CONTACT_EMAIL=
PLACES_REFRESH_DAYS=30
