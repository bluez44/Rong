NODE_ENV=development
PORT=3001

# Postgres + PostGIS — khớp với infra/docker-compose.yml
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=rong
DB_PASSWORD=rong
DB_DATABASE=rong

# Redis — Socket.IO adapter và hàng đợi worker
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis có mật khẩu (Redis Cloud: user "default" + mật khẩu của database). Trống khi chạy local.
REDIS_USERNAME=
REDIS_PASSWORD=
# true = kết nối qua TLS (bật khi database Redis Cloud bật "TLS").
REDIS_TLS=false

# Gợi ý lịch trình trang chủ: hàng đợi BullMQ trên Redis ở trên. false = chạy job ngay trong
# process, không có lịch làm mới 6:00/15:00 (dùng khi máy không chạy Redis). e2e luôn tắt.
# NODE_ENV=production: chỉ bật khi REDIS_HOST được đặt rõ (compose production chưa có Redis).
# Redis không tới được thì app vẫn chạy: lệnh hàng đợi lỗi sau vài giây, trang chủ trả "building".
RECOMMENDATIONS_ENABLED=true
# Ảnh vùng từ Unsplash (https://unsplash.com/developers). Trống thì dùng ảnh từ bài viết, ghi nguồn.
UNSPLASH_ACCESS_KEY=

# Google Maps Platform — gọi theo thời gian thực, chỉ lưu place_id (PRD mục 7.4).
# Cần bật "Places API (New)". Để trống thì màn hình chi tiết không có phần Google.
# Cùng khóa này dùng cho Geocoding API (định vị địa điểm của API v2) — cần bật "Geocoding API".
GOOGLE_MAPS_API_KEY=

# Gemini API, gói trả phí (PRD mục 7.4, nguyên tắc 5)
GEMINI_API_KEY=

# Tavily (tìm web + lấy nội dung bài viết) cho API v2 danh sách địa điểm:
# GET /api/v2/regions/:id/places. Để trống thì API v2 trả 503. https://tavily.com
TAVILY_API_KEY=

# Xác thực — sinh khóa bằng: openssl rand -base64 48 (tối thiểu 32 ký tự)
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
GUEST_RETENTION_DAYS=30

# Xác minh email sau khi đăng ký: gửi mã 6 chữ số, người dùng nhập mã trong app.
EMAIL_VERIFICATION_TTL_MINUTES=15

# Gửi email qua SMTP. Để trống SMTP_HOST thì email chỉ được ghi ra log (tiện khi dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Rong <no-reply@rong.local>
RESEND_API_KEY=

# Dữ liệu mở cho tìm kiếm điểm đến (S2). Instance công cộng có giới hạn: Nominatim
# 1 request/giây, không dùng cho autocomplete. Production nên tự host hoặc dùng
# nhà cung cấp trả phí, rồi trỏ URL dưới đây sang đó.
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Bắt buộc theo chính sách sử dụng của OSM: email liên hệ gửi kèm User-Agent.
OPEN_DATA_CONTACT_EMAIL=
# Chia sẻ vào app (F4). Số lượt tối đa mỗi người trong 24 giờ.
SHARE_IMPORT_DAILY_LIMIT=30
# Token Meta dạng "app_id|client_token" để đọc oEmbed Facebook/Instagram. Trống thì đọc Open Graph.
META_OEMBED_TOKEN=
# Tìm địa điểm trong màn vùng: số lượt tìm Google Maps tối đa mỗi người trong 24 giờ.
PLACE_SEARCH_DAILY_LIMIT=60
# Số lượt xem trước/lưu địa điểm Google Maps (khi phải gọi Google) tối đa mỗi người trong 24 giờ.
PLACE_DETAILS_DAILY_LIMIT=150
# Danh sách địa điểm từ bài viết: làm mới sau N ngày; lần đầu chờ tối đa N ms rồi trả "building".
WEB_PLACES_REFRESH_DAYS=30
WEB_PLACES_WAIT_MS=25000
# Ghép địa điểm từ bài viết với Google Places để lấy tọa độ. Tắt: Việt Nam là Prohibited Territory
# của Google Maps Platform (Places trả 403). Tắt thì dùng tọa độ AI, hiện "Vị trí gần đúng".
WEB_PLACES_GOOGLE_MATCH=false

# Link mời nhóm (F10): SHA-256 chứng chỉ ký APK cho /.well-known/assetlinks.json (Android App Links),
# nhiều giá trị cách nhau dấu phẩy. Bản release trên GitHub Releases (keystore EAS):
# 0F:E4:75:E1:89:95:40:90:D6:C9:77:98:B3:1E:06:C9:C7:75:D1:92:3D:E3:84:AC:DB:F9:01:71:2E:C6:DE:34
ANDROID_APP_LINK_SHA256=
