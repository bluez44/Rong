# Google Maps SDK keys (khoa rieng cho tung nen tang, han che theo bundle id)
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=

# Backend NestJS
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# Trang web xem lịch trình được chia sẻ (apps/web), không có / ở cuối
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:3000

# Đăng nhập Google: Web Client ID trên Google Cloud (spec 2026-10-21-google-zalo-login §7.A). Trống = ẩn nút.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Đăng nhập Zalo: App ID trên developers.zalo.me (§7.B). Đọc lúc build; trống = ẩn nút.
ZALO_APP_ID=
